<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <script src="https://docs.getgrist.com/grist-plugin-api.js"></script>
  <style>
    html, body {
      margin: 0;
      padding: 0;
      background: transparent;
      font-family: Arial, sans-serif;
      color: inherit;
    }

    body {
      padding: 8px;
    }

    input[type="text"] {
      width: 100%;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
      background: transparent;
      color: inherit;
      border: 1px solid #ccc;
      border-radius: 4px;
      padding: 6px 8px;
      outline: none;
    }
  </style>
</head>
<body>
  <input id="search" type="text" placeholder="Cerca una misura..." />

<script>
    function normalize(value) {
      return String(value ?? "").toLowerCase();
    }

    function applyFilter() {
      const query = normalize(document.getElementById("search").value.trim());

      grist.setOptions({
        filters: query ? [{
          column_id: "Measure",
          filter: JSON.stringify({ contains: query })
        }] : []
      });
    }

    document.getElementById("search").addEventListener("input", applyFilter);

    grist.ready({ access: "none" });
  </script>

</body>
</html>
